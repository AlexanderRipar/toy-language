pub next = proc(mut core: *mut CoreData) -> Lexeme => {
	if (core.parser.&.peek.token != EMPTY) then {
		let rst = /* cpp ctor */ init(core.parser.&.peek) 
		core.parser.&.peek.token = EMPTY 
		return /* cpp ctor */ init(rst)
	} 
	skip_whitespace(core) 
	let source_id = cast(SourceId, (core.parser.&.source_id_base + cast(u32, (core.parser.&.curr - core.parser.&.begin)))) 
	mut rst = next_without_source(core) 
	rst.source_id = source_id 
	return /* cpp ctor */ init(rst)
}

pub peek = proc(mut core: *mut CoreData) -> Lexeme => {
	if (core.parser.&.peek.token == EMPTY) then
		cpp_operator_set(core.parser.&.peek, next(core)) 
	return /* cpp ctor */ init(core.parser.&.peek)
}

pub peek_n = proc(mut core: *mut CoreData, mut n: u32) -> Lexeme => {
	for true do {
		{
			{
				if !(((n != cast(u32, 0)))) then
					assert_or_ignore_helper(cast(*char, "core/parse.cpp"), cast(u32, 1474), cast(*char, "n != 0"))
			}
		}
		if !(False) then 
			break {}
	} 
	let remembered_peek = peek(core) 
	let remembered_curr = core.parser.&.curr 
	core.parser.&.peek.token = EMPTY 
	mut result = /* cpp ctor */ init(remembered_peek) 
	for (i != n), preinc(i.&) do
		cpp_operator_set(result, next(core)) 
	core.parser.&.curr = remembered_curr 
	cpp_operator_set(core.parser.&.peek, remembered_peek) 
	return /* cpp ctor */ init(result)
}

pub skip = proc(mut core: *mut CoreData) -> void => {
	cast(void, next(core))
}

pub pop_operator = proc(mut core: *mut CoreData, mut stack: *mut OperatorStack) -> void => {
	for true do {
		{
			{
				if !(((stack.operator_top.& != cast(u32, 0)))) then
					assert_or_ignore_helper(cast(*char, "core/parse.cpp"), cast(u32, 1503), cast(*char, "stack->operator_top != 0"))
			}
		}
		if !(False) then 
			break {}
	} 
	let top = /* cpp ctor */ init(cast(*mut OperatorDescWithSource, stack.operators.&)[(stack.operator_top.& - cast(u32, 1))]) 
	stack.operator_top.& = cast(u32, 1) 
	if (top.operator_desc.node_type == INVALID) then
		return {} 
	if (stack.operand_count.& <= cast(u32, top.operator_desc.is_binary)) then {
		let error = if cast(bool, top.operator_desc.is_binary) then
				ParseBinaryOperatorMissingOperand
else
				ParseUnaryOperatorMissingOperand 
		parse_error_fatal(core, stack.expression_source_id.&, error)
	} 
	if cast(bool, top.operator_desc.is_binary) then
		stack.operand_count.& = cast(u32, 1) 
	let operator_token = push_node(core, cast(*mut AstBuilderToken, stack.operand_tokens.&)[(stack.operand_count.& - cast(u32, 1))], top.source_id, top.operator_desc.node_flags, top.operator_desc.node_type) 
	cast(*mut AstBuilderToken, stack.operand_tokens.&)[(stack.operand_count.& - cast(u32, 1))] = operator_token
}

pub pop_to_precedence = proc(mut core: *mut CoreData, mut stack: *mut OperatorStack, mut precedence: u8, mut pop_equal: bool) -> bool => {
	for (stack.operator_top.& != cast(u32, 0)) do {
		let top = /* cpp ctor */ init(cast(*mut OperatorDescWithSource, stack.operators.&)[(stack.operator_top.& - cast(u32, 1))]) 
		if ((cast(int, top.operator_desc.precedence) > cast(int, precedence)) || (((cast(int, top.operator_desc.precedence) == cast(int, precedence)) && !(pop_equal)))) then
			return True 
		pop_operator(core, stack)
	} 
	return False
}

pub push_operand = proc(mut core: *mut CoreData, mut stack: *mut OperatorStack, mut operand_token: AstBuilderToken) -> void => {
	if (cast(u64, stack.operand_count.&) == (array_count(stack.operand_tokens.&) - cast(u64, 1))) then
		parse_error_fatal(core, stack.expression_source_id.&, ParseOpenOperandCountTooLarge) 
	cast(*mut AstBuilderToken, stack.operand_tokens.&)[stack.operand_count.&] = operand_token 
	stack.operand_count.& = cast(u32, 1)
}

pub push_operator = proc(mut core: *mut CoreData, mut stack: *mut OperatorStack, mut op: OperatorDescWithSource) -> void => {
	if (op.operator_desc.node_type != INVALID) then
		pop_to_precedence(core, stack, op.operator_desc.precedence, cast(bool, op.operator_desc.is_right_to_left)) 
	if (cast(u64, stack.operator_top.&) == array_count(stack.operators.&)) then
		parse_error_fatal(core, stack.expression_source_id.&, ParseOpenOperatorCountTooLarge) 
	cpp_operator_set(cast(*mut OperatorDescWithSource, stack.operators.&)[stack.operator_top.&], op) 
	stack.operator_top.& = cast(u32, 1)
}

pub remove_lparen = proc(mut stack: *mut OperatorStack) -> void => {
	for true do {
		{
			{
				if !((((stack.operator_top.& != cast(u32, 0)) && (cast(*mut OperatorDescWithSource, stack.operators.&)[(stack.operator_top.& - cast(u32, 1))].operator_desc.node_type == INVALID)))) then
					assert_or_ignore_helper(cast(*char, "core/parse.cpp"), cast(u32, 1569), cast(*char, "stack->operator_top != 0 && stack->operators[stack->operator_top - 1].operator_desc.node_type == AstTag::INVALID"))
			}
		}
		if !(False) then 
			break {}
	} 
	stack.operator_top.& = cast(u32, 1)
}

pub pop_remaining = proc(mut core: *mut CoreData, mut stack: *mut OperatorStack) -> AstBuilderToken => {
	for (stack.operator_top.& != cast(u32, 0)) do
		pop_operator(core, stack) 
	if (stack.operand_count.& != cast(u32, 1)) then
		parse_error_fatal(core, stack.expression_source_id.&, ParseOperatorOperandCountMismatch) 
	return cast(*mut AstBuilderToken, stack.operand_tokens.&)[0]
}

pub is_definition_start = proc(mut token: Token) -> bool => {
	return (((token == KwdLet) || (token == KwdPub)) || (token == KwdMut))
}

pub parse_definition = proc(mut core: *mut CoreData, mut is_optional_type: bool, mut is_optional_value: bool, mut is_param: bool, mut out_variadic_source_id: *mut Maybe(SourceId)) -> AstBuilderToken => {
	mut flags = EMPTY 
	mut lexeme = next(core) 
	let source_id = lexeme.source_id 
	if (is_param && (lexeme.token == KwdEval)) then {
		cpp_operator_bitor_set(flags, Definition_IsEval) 
		cpp_operator_set(lexeme, next(core))
	} 
	if (lexeme.token == KwdLet) then {
		cpp_operator_set(lexeme, next(core))
	} else {
		for True do {
			if (lexeme.token == KwdPub) then {
				if is_param then
					parse_error_continuable(core, lexeme.source_id, ParseFunctionParameterIsPub) 
				if ((cpp_operator_bitand(flags, Definition_IsPub)) != EMPTY) then
					parse_error_continuable(core, lexeme.source_id, ParseDefinitionMultiplePub) 
				cpp_operator_bitor_set(flags, Definition_IsPub)
			} else if (lexeme.token == KwdMut) then {
				if ((cpp_operator_bitand(flags, Definition_IsMut)) != EMPTY) then
					parse_error_continuable(core, lexeme.source_id, ParseDefinitionMultipleMut) 
				cpp_operator_bitor_set(flags, Definition_IsMut)
			} else {
				break {}
			} 
			cpp_operator_set(lexeme, next(core))
		}
	} 
	if (lexeme.token != Ident) then
		parse_error_fatal(core, lexeme.source_id, ParseDefinitionMissingName) 
	let identifier_id = lexeme.identifier_id 
	cpp_operator_set(lexeme, peek(core)) 
	mut first_child_token = NO_CHILDREN 
	if (lexeme.token == Colon) then {
		cpp_operator_bitor_set(flags, Definition_HasType) 
		skip(core) 
		cpp_operator_set(lexeme, peek(core)) 
		if (is_param && (lexeme.token == TypVar)) then {
			let variadic_source_id = lexeme.source_id 
			cpp_operator_set((out_variadic_source_id).*, some(variadic_source_id)) 
			skip(core) 
			let expr_token = parse_expr(core, False) 
			first_child_token = push_node(core, expr_token, variadic_source_id, EMPTY, UOpTypeVarArgs)
		} else {
			if is_param then
				cpp_operator_set((out_variadic_source_id).*, none()) 
			first_child_token = parse_expr(core, False)
		} 
		cpp_operator_set(lexeme, peek(core))
	} else if !(is_optional_type) then {
		parse_error_continuable(core, lexeme.source_id, ParseDefinitionMissingColon)
	} 
	if (lexeme.token == OpSet) then {
		skip(core) 
		let value_token = parse_expr(core, True) 
		if (first_child_token == NO_CHILDREN) then
			first_child_token = value_token
	} else if !(is_optional_value) then {
		parse_error_continuable(core, lexeme.source_id, ParseDefinitionMissingEquals)
	} 
	return push_node(core, first_child_token, source_id, flags, .{
				identifier_id, 
				INVALID
			})
}

pub parse_return = proc(mut core: *mut CoreData) -> AstBuilderToken => {
	for true do {
		{
			{
				if !(((peek(core).token == KwdReturn))) then
					assert_or_ignore_helper(cast(*char, "core/parse.cpp"), cast(u32, 1710), cast(*char, "peek(core).token == Token::KwdReturn"))
			}
		}
		if !(False) then 
			break {}
	} 
	let source_id = next(core).source_id 
	let value_token = parse_expr(core, True) 
	return push_node(core, value_token, source_id, EMPTY, Return)
}

pub parse_break = proc(mut core: *mut CoreData) -> AstBuilderToken => {
	for true do {
		{
			{
				if !(((peek(core).token == KwdBreak))) then
					assert_or_ignore_helper(cast(*char, "core/parse.cpp"), cast(u32, 1721), cast(*char, "peek(core).token == Token::KwdBreak"))
			}
		}
		if !(False) then 
			break {}
	} 
	let source_id = next(core).source_id 
	let value_token = parse_expr(core, True) 
	return push_node(core, value_token, source_id, EMPTY, Break)
}

pub parse_argument = proc(mut core: *mut CoreData) -> AstBuilderToken => {
	let lexeme = peek(core) 
	if (is_definition_start(lexeme.token) || (((lexeme.token == Ident) && (peek_n(core, cast(u32, 1)).token == Colon)))) then
		return parse_definition(core, True, True, False, cast(*mut Maybe(SourceId), null))
	else
		return parse_expr(core, True)
}

pub parse_statement = proc(mut core: *mut CoreData, mut out_is_definition: *mut bool) -> AstBuilderToken => {
	let lexeme = peek(core) 
	let is_definition = is_definition_start(lexeme.token) 
	(out_is_definition).* = is_definition 
	if is_definition then
		return parse_definition(core, True, False, False, cast(*mut Maybe(SourceId), null))
	else if (lexeme.token == KwdReturn) then
		return parse_return(core)
	else if (lexeme.token == KwdBreak) then
		return parse_break(core)
	else
		return parse_expr(core, True)
}

pub parse_where = proc(mut core: *mut CoreData) -> AstBuilderToken => {
	for true do {
		{
			{
				if !(((peek(core).token == KwdWhere))) then
					assert_or_ignore_helper(cast(*char, "core/parse.cpp"), cast(u32, 1760), cast(*char, "peek(core).token == Token::KwdWhere"))
			}
		}
		if !(False) then 
			break {}
	} 
	let source_id = next(core).source_id 
	let first_child_token = parse_definition(core, True, False, False, cast(*mut Maybe(SourceId), null)) 
	mut definition_count = cast(u16, 0) 
	for True do {
		if (peek(core).token != Comma) then
			break {} 
		skip(core) 
		let definition_source_id = peek(core).source_id 
		parse_definition(core, True, False, False, cast(*mut Maybe(SourceId), null)) 
		if (cast(int, definition_count) == cast(int, 65535)) then
			parse_error_continuable(core, definition_source_id, ScopeTooManyDefinitions) 
		definition_count = 1
	} 
	return push_node(core, first_child_token, source_id, EMPTY, .{
				definition_count, 
				cast(u32, 0)
			})
}

pub parse_if = proc(mut core: *mut CoreData) -> AstBuilderToken => {
	for true do {
		{
			{
				if !(((peek(core).token == KwdIf))) then
					assert_or_ignore_helper(cast(*char, "core/parse.cpp"), cast(u32, 1790), cast(*char, "peek(core).token == Token::KwdIf"))
			}
		}
		if !(False) then 
			break {}
	} 
	mut flags = EMPTY 
	let source_id = next(core).source_id 
	let first_child_token = parse_expr(core, False) 
	mut lexeme = peek(core) 
	if (lexeme.token == KwdWhere) then {
		cpp_operator_bitor_set(flags, If_HasWhere) 
		parse_where(core) 
		cpp_operator_set(lexeme, peek(core))
	} 
	if (lexeme.token == KwdThen) then
		skip(core) 
	 consequent_is_definition = undefined 
	parse_statement(core, (consequent_is_definition).&) 
	if consequent_is_definition then
		parse_error_continuable(core, lexeme.source_id, ParseUnexpectedTopLevelExpr) 
	cpp_operator_set(lexeme, peek(core)) 
	if (lexeme.token == KwdElse) then {
		cpp_operator_bitor_set(flags, If_HasElse) 
		skip(core) 
		 alternative_is_definition = undefined 
		parse_statement(core, (alternative_is_definition).&) 
		if alternative_is_definition then
			parse_error_continuable(core, lexeme.source_id, ParseUnexpectedTopLevelExpr)
	} 
	return push_node(core, first_child_token, source_id, flags, If)
}

pub try_parse_foreach = proc(mut core: *mut CoreData, mut source_id: SourceId) -> AstBuilderToken => {
	mut is_foreach = False 
	if is_definition_start(peek(core).token) then {
		is_foreach = True
	} else if (lookahead_1.token == ThinArrowL) where let lookahead_1 = peek_n(core, cast(u32, 1)) then {
		is_foreach = True
	} else if (lookahead_1.token == Comma) then {
		if is_definition_start(lookahead_2.token) where let lookahead_2 = peek_n(core, cast(u32, 2)) then
			is_foreach = True 
		if (lookahead_3.token == ThinArrowL) where let lookahead_3 = peek_n(core, cast(u32, 3)) then
			is_foreach = True
	} 
	if !(is_foreach) then
		return NO_CHILDREN 
	mut flags = EMPTY 
	let first_child_token = parse_definition(core, True, True, False, cast(*mut Maybe(SourceId), null)) 
	mut lexeme = peek(core) 
	if (lexeme.token == Comma) then {
		cpp_operator_bitor_set(flags, ForEach_HasIndex) 
		skip(core) 
		parse_definition(core, True, True, False, cast(*mut Maybe(SourceId), null)) 
		cpp_operator_set(lexeme, peek(core))
	} 
	if (lexeme.token != ThinArrowL) then
		parse_error_fatal(core, lexeme.source_id, ParseForeachExpectThinArrowLeft) 
	skip(core) 
	parse_expr(core, False) 
	cpp_operator_set(lexeme, peek(core)) 
	if (lexeme.token == KwdWhere) then {
		cpp_operator_bitor_set(flags, ForEach_HasWhere) 
		parse_where(core) 
		cpp_operator_set(lexeme, peek(core))
	} 
	if (lexeme.token == KwdDo) then
		skip(core) 
	parse_expr(core, True) 
	cpp_operator_set(lexeme, peek(core)) 
	if (lexeme.token == KwdFinally) then {
		cpp_operator_bitor_set(flags, ForEach_HasFinally) 
		parse_expr(core, True)
	} 
	return push_node(core, first_child_token, source_id, flags, ForEach)
}

pub parse_for = proc(mut core: *mut CoreData) -> AstBuilderToken => {
	for true do {
		{
			{
				if !(((peek(core).token == KwdFor))) then
					assert_or_ignore_helper(cast(*char, "core/parse.cpp"), cast(u32, 1915), cast(*char, "peek(core).token == Token::KwdFor"))
			}
		}
		if !(False) then 
			break {}
	} 
	mut flags = EMPTY 
	let source_id = next(core).source_id 
	if (foreach_token != NO_CHILDREN) where let foreach_token = try_parse_foreach(core, source_id) then
		return foreach_token 
	let first_child_token = parse_expr(core, False) 
	mut lexeme = peek(core) 
	if (lexeme.token == Comma) then {
		cpp_operator_bitor_set(flags, For_HasStep) 
		skip(core) 
		parse_expr(core, True) 
		cpp_operator_set(lexeme, peek(core))
	} 
	if (lexeme.token == KwdWhere) then {
		cpp_operator_bitor_set(flags, For_HasWhere) 
		parse_where(core) 
		cpp_operator_set(lexeme, peek(core))
	} 
	if (lexeme.token == KwdDo) then
		skip(core) 
	parse_expr(core, True) 
	cpp_operator_set(lexeme, peek(core)) 
	if (lexeme.token == KwdFinally) then {
		cpp_operator_bitor_set(flags, For_HasFinally) 
		parse_expr(core, True)
	} 
	return push_node(core, first_child_token, source_id, flags, For)
}

pub parse_case = proc(mut core: *mut CoreData) -> AstBuilderToken => {
	for true do {
		{
			{
				if !(((peek(core).token == KwdCase))) then
					assert_or_ignore_helper(cast(*char, "core/parse.cpp"), cast(u32, 1967), cast(*char, "peek(core).token == Token::KwdCase"))
			}
		}
		if !(False) then 
			break {}
	} 
	let source_id = next(core).source_id 
	let first_child_token = parse_expr(core, False) 
	mut lexeme = next(core) 
	if (lexeme.token != ThinArrowR) then
		parse_error_fatal(core, lexeme.source_id, ParseCaseMissingThinArrowRight) 
	return push_node(core, first_child_token, source_id, EMPTY, Case)
}

pub parse_switch = proc(mut core: *mut CoreData) -> AstBuilderToken => {
	for true do {
		{
			{
				if !(((peek(core).token == KwdSwitch))) then
					assert_or_ignore_helper(cast(*char, "core/parse.cpp"), cast(u32, 1983), cast(*char, "peek(core).token == Token::KwdSwitch"))
			}
		}
		if !(False) then 
			break {}
	} 
	mut flags = EMPTY 
	let source_id = next(core).source_id 
	let first_child_token = parse_expr(core, False) 
	mut lexeme = peek(core) 
	if (lexeme.token == KwdWhere) then {
		cpp_operator_bitor_set(flags, Switch_HasWhere) 
		parse_where(core) 
		cpp_operator_set(lexeme, peek(core))
	} 
	if (lexeme.token == KwdCase) then {
		for True do {
			parse_case(core) 
			cpp_operator_set(lexeme, peek(core)) 
			if (lexeme.token != KwdCase) then
				break {}
		}
	} else {
		parse_error_continuable(core, lexeme.source_id, ParseSwitchMissingCase)
	} 
	return push_node(core, first_child_token, source_id, flags, Switch)
}

pub parse_requires = proc(mut core: *mut CoreData) -> AstBuilderToken => {
	for true do {
		{
			{
				if !(((peek(core).token == KwdRequires))) then
					assert_or_ignore_helper(cast(*char, "core/parse.cpp"), cast(u32, 2024), cast(*char, "peek(core).token == Token::KwdRequires"))
			}
		}
		if !(False) then 
			break {}
	} 
	let source_id = next(core).source_id 
	let first_child_token = parse_expr(core, False) 
	for True do {
		if (peek(core).token != Comma) then
			break {} 
		skip(core) 
		parse_expr(core, False)
	} 
	return push_node(core, first_child_token, source_id, EMPTY, cpp_requires)
}

pub parse_ensures = proc(mut core: *mut CoreData) -> AstBuilderToken => {
	for true do {
		{
			{
				if !(((peek(core).token == KwdEnsures))) then
					assert_or_ignore_helper(cast(*char, "core/parse.cpp"), cast(u32, 2045), cast(*char, "peek(core).token == Token::KwdEnsures"))
			}
		}
		if !(False) then 
			break {}
	} 
	let source_id = next(core).source_id 
	let first_child_token = parse_expr(core, False) 
	for True do {
		if (peek(core).token != Comma) then
			break {} 
		skip(core) 
		parse_expr(core, False)
	} 
	return push_node(core, first_child_token, source_id, EMPTY, cpp_ensures)
}

pub parse_signature = proc(mut core: *mut CoreData) -> AstBuilderToken => {
	mut flags = EMPTY 
	mut lexeme = next(core) 
	let func_source_id = lexeme.source_id 
	if (lexeme.token == KwdProc) then
		cpp_operator_bitor_set(flags, Signature_IsProc)
	else
		for true do {
			{
				{
					if !(((lexeme.token == KwdFunc))) then
						assert_or_ignore_helper(cast(*char, "core/parse.cpp"), cast(u32, 2075), cast(*char, "lexeme.token == Token::KwdFunc"))
				}
			}
			if !(False) then 
				break {}
		} 
	cpp_operator_set(lexeme, next(core)) 
	let parameter_list_source_id = lexeme.source_id 
	if (lexeme.token != ParenL) then {
		let error = if ((cpp_operator_bitand(flags, Signature_IsProc)) == EMPTY) then
				ParseSignatureMissingParenthesisAfterProc
else
				ParseSignatureMissingParenthesisAfterFunc 
		parse_error_fatal(core, lexeme.source_id, error)
	} 
	cpp_operator_set(lexeme, peek(core)) 
	mut first_parameter_token = NO_CHILDREN 
	mut param_count = cast(u32, 0) 
	mut variadic_source_id = none() 
	for (lexeme.token != ParenR) do {
		if (param_count == MAX_FUNC_PARAM_COUNT) then
			parse_error_continuable(core, lexeme.source_id, ParseSignatureTooManyParameters) 
		if is_some(/* cpp ctor */ init(variadic_source_id)) then
			parse_error_continuable(core, get(/* cpp ctor */ init(variadic_source_id)), ParseDefinitionUnexpectedVariadic) 
		cpp_operator_set(variadic_source_id, none()) 
		param_count = cast(u32, 1) 
		let parameter_token = parse_definition(core, True, True, True, (variadic_source_id).&) 
		if (first_parameter_token == NO_CHILDREN) then
			first_parameter_token = parameter_token 
		cpp_operator_set(lexeme, peek(core)) 
		if (lexeme.token == Comma) then
			skip(core)
		else if (lexeme.token != ParenR) then
			parse_error_fatal(core, lexeme.source_id, ParseSignatureUnexpectedParameterListEnd)
	} 
	let parameter_list_token = push_node(core, first_parameter_token, parameter_list_source_id, EMPTY, ParameterList) 
	skip(core) 
	cpp_operator_set(lexeme, peek(core)) 
	if (lexeme.token != ThinArrowR) then
		parse_error_fatal(core, lexeme.source_id, ParseSignatureMissingReturnType) 
	skip(core) 
	parse_expr(core, False) 
	cpp_operator_set(lexeme, peek(core)) 
	if (lexeme.token == KwdRequires) then {
		cpp_operator_bitor_set(flags, Signature_HasRequires) 
		parse_requires(core) 
		cpp_operator_set(lexeme, peek(core))
	} 
	if (lexeme.token == KwdEnsures) then {
		cpp_operator_bitor_set(flags, Signature_HasEnsures) 
		parse_ensures(core)
	} 
	return push_node(core, parameter_list_token, func_source_id, flags, .{
				none(), 
				cast(u8, param_count)
			})
}

pub parse_func = proc(mut core: *mut CoreData) -> AstBuilderToken => {
	mut flags = EMPTY 
	mut lexeme = peek(core) 
	let func_source_id = lexeme.source_id 
	let signature_token = parse_signature(core) 
	cpp_operator_set(lexeme, peek(core)) 
	if (lexeme.token != WideArrowR) then
		return signature_token 
	skip(core) 
	parse_expr(core, True) 
	return push_node(core, signature_token, func_source_id, flags, .{
				none(), 
				cast(u32, 0)
			})
}

pub parse_trait = proc(mut core: *mut CoreData) -> AstBuilderToken => {
	for true do {
		{
			{
				if !(((peek(core).token == KwdTrait))) then
					assert_or_ignore_helper(cast(*char, "core/parse.cpp"), cast(u32, 2185), cast(*char, "peek(core).token == Token::KwdTrait"))
			}
		}
		if !(False) then 
			break {}
	} 
	mut flags = EMPTY 
	let source_id = next(core).source_id 
	mut lexeme = next(core) 
	if (lexeme.token != ParenL) then
		parse_error_fatal(core, lexeme.source_id, ParseSignatureMissingParenthesisAfterTrait) 
	let parameter_list_source_id = lexeme.source_id 
	cpp_operator_set(lexeme, next(core)) 
	mut first_parameter_token = NO_CHILDREN 
	mut parameter_count = cast(u32, 0) 
	for (lexeme.token != ParenR) do {
		parameter_count = cast(u32, 1) 
		if (lexeme.token != Ident) then
			parse_error_fatal(core, lexeme.source_id, ParseTraitParameterMissingName) 
		let parameter_token = push_node(core, NO_CHILDREN, lexeme.source_id, EMPTY, .{
lexeme.identifier_id, 
					INVALID
				}) 
		if (first_parameter_token == NO_CHILDREN) then
			first_parameter_token = parameter_token 
		cpp_operator_set(lexeme, next(core)) 
		if (lexeme.token == Comma) then
			cpp_operator_set(lexeme, next(core))
		else if (lexeme.token != ParenR) then
			parse_error_fatal(core, lexeme.source_id, ParseSignatureMissingParenthesisAfterTrait)
	} 
	let first_child_token = push_node(core, first_parameter_token, parameter_list_source_id, EMPTY, .{
				parameter_count, 
				cast(u32, 0)
			}) 
	cpp_operator_set(lexeme, next(core)) 
	if (lexeme.token == KwdRequires) then {
		parse_requires(core) 
		cpp_operator_set(lexeme, next(core))
	} 
	if (lexeme.token != CurlyL) then
		parse_error_fatal(core, lexeme.source_id, ParseTraitExpectOpeningCurly) 
	for True do {
		cpp_operator_set(lexeme, peek(core)) 
		if (lexeme.token == CurlyR) then
			break {} 
		parse_definition(core, False, True, False, cast(*mut Maybe(SourceId), null))
	} 
	skip(core) 
	return push_node(core, first_child_token, source_id, flags, cpp_trait)
}

pub parse_expr = proc(mut core: *mut CoreData, mut allow_complex: bool) -> AstBuilderToken => {
	mut lexeme = peek(core) 
	mut stack = /* cpp ctor */ init() 
	stack.operator_top = cast(u32, 0) 
	stack.operand_count = cast(u32, 0) 
	stack.expression_source_id = lexeme.source_id 
	mut expecting_operand = True 
	for True do {
		if expecting_operand then {
			if (lexeme.token == Ident) then {
				expecting_operand = False 
				let value_token = push_node(core, NO_CHILDREN, lexeme.source_id, EMPTY, .{
lexeme.identifier_id, 
							INVALID, 
							.{
								cast(u64, 0)
							}
						}) 
				push_operand(core, (stack).&, value_token)
			} else if (lexeme.token == LitString) then {
				expecting_operand = False 
				let value_token = push_node(core, NO_CHILDREN, lexeme.source_id, EMPTY, .{
lexeme.string.value_begin, 
lexeme.string.value_size
						}) 
				push_operand(core, (stack).&, value_token)
			} else if (lexeme.token == LitFloat) then {
				expecting_operand = False 
				let value_token = push_node(core, NO_CHILDREN, lexeme.source_id, EMPTY, .{
							/* cpp ctor */ init(lexeme.float_value)
						}) 
				push_operand(core, (stack).&, value_token)
			} else if (lexeme.token == LitInteger) then {
				expecting_operand = False 
				let value_token = push_node(core, NO_CHILDREN, lexeme.source_id, EMPTY, .{
							/* cpp ctor */ init(lexeme.integer_value)
						}) 
				push_operand(core, (stack).&, value_token)
			} else if (lexeme.token == LitChar) then {
				expecting_operand = False 
				let value_token = push_node(core, NO_CHILDREN, lexeme.source_id, EMPTY, .{
lexeme.char_value, 
							cast(u32, 0)
						}) 
				push_operand(core, (stack).&, value_token)
			} else if (lexeme.token == Wildcard) then {
				expecting_operand = False 
				let value_token = push_node(core, NO_CHILDREN, lexeme.source_id, EMPTY, Wildcard) 
				push_operand(core, (stack).&, value_token)
			} else if (lexeme.token == CompositeInitializer) then {
				expecting_operand = False 
				let source_id = lexeme.source_id 
				skip(core) 
				cpp_operator_set(lexeme, peek(core)) 
				mut first_child_token = NO_CHILDREN 
				for (lexeme.token != CurlyR) do {
					let curr_token = parse_expr(core, True) 
					if (first_child_token == NO_CHILDREN) then
						first_child_token = curr_token 
					cpp_operator_set(lexeme, peek(core)) 
					if (lexeme.token == Comma) then {
						skip(core) 
						cpp_operator_set(lexeme, peek(core))
					} else if (lexeme.token != CurlyR) then {
						parse_error_fatal(core, lexeme.source_id, ParseCompositeLiteralUnexpectedToken)
					}
				} 
				let composite_token = push_node(core, first_child_token, source_id, EMPTY, CompositeInitializer) 
				push_operand(core, (stack).&, composite_token)
			} else if (lexeme.token == ArrayInitializer) then {
				expecting_operand = False 
				let source_id = lexeme.source_id 
				skip(core) 
				cpp_operator_set(lexeme, peek(core)) 
				mut first_child_token = NO_CHILDREN 
				for (lexeme.token != BracketR) do {
					let curr_token = parse_expr(core, True) 
					if (first_child_token == NO_CHILDREN) then
						first_child_token = curr_token 
					cpp_operator_set(lexeme, peek(core)) 
					if (lexeme.token == Comma) then {
						skip(core) 
						cpp_operator_set(lexeme, peek(core))
					} else if (lexeme.token != BracketR) then {
						parse_error_fatal(core, lexeme.source_id, ParseArrayLiteralUnexpectedToken)
					}
				} 
				let array_token = push_node(core, first_child_token, source_id, EMPTY, ArrayInitializer) 
				push_operand(core, (stack).&, array_token)
			} else if (lexeme.token == BracketL) then {
				let source_id = lexeme.source_id 
				skip(core) 
				let count_token = parse_expr(core, False) 
				cpp_operator_set(lexeme, peek(core)) 
				if (lexeme.token != BracketR) then
					parse_error_fatal(core, lexeme.source_id, ParseArrayTypeUnexpectedToken) 
				push_operand(core, (stack).&, count_token) 
				push_operator(core, (stack).&, .{
						.{
							OpTypeArray, 
							EMPTY, 
							cast(u8, 2), 
							cast(u8, False), 
							cast(u8, True)
						}, 
						source_id
					})
			} else if (lexeme.token == CurlyL) then {
				expecting_operand = False 
				let source_id = lexeme.source_id 
				skip(core) 
				cpp_operator_set(lexeme, peek(core)) 
				mut first_child_token = NO_CHILDREN 
				mut definition_count = cast(u16, 0) 
				mut prev_was_definition = False 
				for (lexeme.token != CurlyR) do {
					 is_definition = undefined 
					let curr_token = parse_statement(core, (is_definition).&) 
					if (first_child_token == NO_CHILDREN) then
						first_child_token = curr_token 
					if prev_was_definition then {
						if (cast(int, definition_count) == cast(int, 65535)) then
							parse_error_continuable(core, lexeme.source_id, ScopeTooManyDefinitions) 
						definition_count = 1
					} 
					prev_was_definition = is_definition 
					cpp_operator_set(lexeme, peek(core)) 
					if (lexeme.token == CurlyR) then
						break {}
				} 
				let block_token = push_node(core, first_child_token, source_id, EMPTY, .{
							definition_count, 
							cast(u32, 0)
						}) 
				push_operand(core, (stack).&, block_token)
			} else if (lexeme.token == KwdIf) then {
				expecting_operand = False 
				let if_token = parse_if(core) 
				push_operand(core, (stack).&, if_token) 
				cpp_operator_set(lexeme, peek(core)) 
				continue
			} else if (lexeme.token == KwdFor) then {
				expecting_operand = False 
				let for_token = parse_for(core) 
				push_operand(core, (stack).&, for_token) 
				cpp_operator_set(lexeme, peek(core)) 
				continue
			} else if (lexeme.token == KwdSwitch) then {
				expecting_operand = False 
				let switch_token = parse_switch(core) 
				push_operand(core, (stack).&, switch_token) 
				cpp_operator_set(lexeme, peek(core)) 
				continue
			} else if ((lexeme.token == KwdFunc) || (lexeme.token == KwdProc)) then {
				expecting_operand = False 
				let func_token = parse_func(core) 
				push_operand(core, (stack).&, func_token) 
				cpp_operator_set(lexeme, peek(core)) 
				continue
			} else if (lexeme.token == KwdTrait) then {
				expecting_operand = False 
				let trait_token = parse_trait(core) 
				push_operand(core, (stack).&, trait_token) 
				cpp_operator_set(lexeme, peek(core)) 
				continue
			} else if (lexeme.token == KwdUnreachable) then {
				expecting_operand = False 
				let value_token = push_node(core, NO_CHILDREN, lexeme.source_id, EMPTY, cpp_unreachable) 
				push_operand(core, (stack).&, value_token)
			} else if (lexeme.token == KwdUndefined) then {
				expecting_operand = False 
				let value_token = push_node(core, NO_CHILDREN, lexeme.source_id, EMPTY, cpp_undefind) 
				push_operand(core, (stack).&, value_token)
			} else if (lexeme.token == KwdSelf) then {
				expecting_operand = False 
				let value_token = push_node(core, NO_CHILDREN, lexeme.source_id, EMPTY, Self) 
				push_operand(core, (stack).&, value_token)
			} else if (lexeme.token == Builtin) then {
				expecting_operand = False 
				let value_token = push_node(core, NO_CHILDREN, lexeme.source_id, EMPTY, .{
lexeme.builtin, 
							cast(u32, 0)
						}) 
				push_operand(core, (stack).&, value_token)
			} else if (lexeme.token == OpMemberOrRef) then {
				expecting_operand = False 
				let source_id = lexeme.source_id 
				skip(core) 
				cpp_operator_set(lexeme, peek(core)) 
				if (lexeme.token != Ident) then
					parse_error_fatal(core, lexeme.source_id, ParseImpliedMemberUnexpectedToken) 
				let implied_member_token = push_node(core, NO_CHILDREN, source_id, EMPTY, .{
lexeme.identifier_id, 
							cast(u32, 0)
						}) 
				push_operand(core, (stack).&, implied_member_token)
			} else {
				if (lexeme.token == TypVar) then
					parse_error_continuable(core, lexeme.source_id, ParseDefinitionUnexpectedVariadic) 
				let source_id = lexeme.source_id 
				let token_ordinal = cast(u8, lexeme.token) 
				let lo_ordinal = cast(u8, ParenL) 
				let hi_ordinal = cast(u8, OpAdd) 
				if ((cast(int, token_ordinal) < cast(int, lo_ordinal)) || (cast(int, token_ordinal) > cast(int, hi_ordinal))) then
					parse_error_fatal(core, lexeme.source_id, ParseExprExpectOperand) 
				mut op = /* cpp ctor */ init(cast(*OperatorDesc, UNARY_OPERATOR_DESCS)[(cast(int, token_ordinal) - cast(int, lo_ordinal))]) 
				skip(core) 
				cpp_operator_set(lexeme, peek(core)) 
				if (op.node_flags == Type_IsMut) then {
					if (lexeme.token == KwdMut) then {
						skip(core) 
						cpp_operator_set(lexeme, peek(core))
					} else {
						op.node_flags = EMPTY
					}
				} 
				push_operator(core, (stack).&, .{
						/* cpp ctor */ init(op), 
						source_id
					}) 
				continue
			}
		} else {
			if (lexeme.token == ParenL) then {
				for true do {
					{
						{
							if !(((stack.operand_count != cast(u32, 0)))) then
								assert_or_ignore_helper(cast(*char, "core/parse.cpp"), cast(u32, 2609), cast(*char, "stack.operand_count != 0"))
						}
					}
					if !(False) then 
						break {}
				} 
				let source_id = lexeme.source_id 
				pop_to_precedence(core, (stack).&, cast(u8, 1), True) 
				skip(core) 
				cpp_operator_set(lexeme, peek(core)) 
				mut arg_count = cast(u32, 0) 
				for (lexeme.token != ParenR) do {
					if (arg_count == MAX_FUNC_PARAM_COUNT) then
						parse_error_continuable(core, lexeme.source_id, ParseCallTooManyArguments) 
					arg_count = cast(u32, 1) 
					parse_argument(core) 
					cpp_operator_set(lexeme, peek(core)) 
					if (lexeme.token == Comma) then {
						skip(core) 
						cpp_operator_set(lexeme, peek(core))
					} else if (lexeme.token != ParenR) then {
						parse_error_fatal(core, lexeme.source_id, ParseCallUnexpectedToken)
					}
				} 
				let call_token = push_node(core, cast(*mut AstBuilderToken, stack.operand_tokens)[(stack.operand_count - cast(u32, 1))], source_id, EMPTY, Call) 
				cast(*mut AstBuilderToken, stack.operand_tokens)[(stack.operand_count - cast(u32, 1))] = call_token
			} else if (lexeme.token == ParenR) then {
				if !(pop_to_precedence(core, (stack).&, cast(u8, 10), False)) then {
					for true do {
						{
							{
								if !(((stack.operand_count == cast(u32, 1)))) then
									assert_or_ignore_helper(cast(*char, "core/parse.cpp"), cast(u32, 2654), cast(*char, "stack.operand_count == 1"))
							}
						}
						if !(False) then 
							break {}
					} 
					return cast(*mut AstBuilderToken, stack.operand_tokens)[(stack.operand_count - cast(u32, 1))]
				} 
				remove_lparen((stack).&)
			} else if (lexeme.token == BracketL) then {
				for true do {
					{
						{
							if !(((stack.operand_count != cast(u32, 0)))) then
								assert_or_ignore_helper(cast(*char, "core/parse.cpp"), cast(u32, 2665), cast(*char, "stack.operand_count != 0"))
						}
					}
					if !(False) then 
						break {}
				} 
				let source_id = lexeme.source_id 
				pop_to_precedence(core, (stack).&, cast(u8, 1), True) 
				skip(core) 
				cpp_operator_set(lexeme, peek(core)) 
				if (lexeme.token == DoubleDot) then {
					mut flags = EMPTY 
					skip(core) 
					cpp_operator_set(lexeme, peek(core)) 
					if (lexeme.token != BracketR) then {
						cpp_operator_bitor_set(flags, OpSliceOf_HasEnd) 
						parse_expr(core, False) 
						cpp_operator_set(lexeme, peek(core)) 
						if (lexeme.token != BracketR) then
							parse_error_fatal(core, lexeme.source_id, ParseSliceUnexpectedToken)
					} 
					let slice_token = push_node(core, cast(*mut AstBuilderToken, stack.operand_tokens)[(stack.operand_count - cast(u32, 1))], source_id, flags, OpSliceOf) 
					cast(*mut AstBuilderToken, stack.operand_tokens)[(stack.operand_count - cast(u32, 1))] = slice_token
				} else {
					parse_expr(core, False) 
					cpp_operator_set(lexeme, peek(core)) 
					if (lexeme.token == BracketR) then {
						let index_token = push_node(core, cast(*mut AstBuilderToken, stack.operand_tokens)[(stack.operand_count - cast(u32, 1))], source_id, EMPTY, OpArrayIndex) 
						cast(*mut AstBuilderToken, stack.operand_tokens)[(stack.operand_count - cast(u32, 1))] = index_token
					} else if (lexeme.token == DoubleDot) then {
						mut flags = OpSliceOf_HasBegin 
						skip(core) 
						cpp_operator_set(lexeme, peek(core)) 
						if (lexeme.token != BracketR) then {
							cpp_operator_bitor_set(flags, OpSliceOf_HasEnd) 
							parse_expr(core, False) 
							cpp_operator_set(lexeme, peek(core)) 
							if (lexeme.token != BracketR) then
								parse_error_fatal(core, lexeme.source_id, ParseSliceUnexpectedToken)
						} 
						let slice_token = push_node(core, cast(*mut AstBuilderToken, stack.operand_tokens)[(stack.operand_count - cast(u32, 1))], source_id, flags, OpSliceOf) 
						cast(*mut AstBuilderToken, stack.operand_tokens)[(stack.operand_count - cast(u32, 1))] = slice_token
					} else {
						parse_error_fatal(core, lexeme.source_id, ParseArrayIndexUnexpectedToken)
					}
				}
			} else if (lexeme.token == KwdCatch) then {
				let source_id = lexeme.source_id 
				mut flags = EMPTY 
				pop_to_precedence(core, (stack).&, cast(u8, 1), True) 
				skip(core) 
				cpp_operator_set(lexeme, peek(core)) 
				if (is_definition_start(lexeme.token) || (peek_n(core, cast(u32, 1)).token == ThinArrowR)) then {
					cpp_operator_bitor_set(flags, Catch_HasDefinition) 
					parse_definition(core, True, True, False, cast(*mut Maybe(SourceId), null)) 
					cpp_operator_set(lexeme, next(core)) 
					if (lexeme.token != ThinArrowR) then
						parse_error_fatal(core, lexeme.source_id, ParseCatchMissingThinArrowRightAfterDefinition)
				} 
				parse_expr(core, False) 
				let catch_token = push_node(core, cast(*mut AstBuilderToken, stack.operand_tokens)[(stack.operand_count - cast(u32, 1))], source_id, flags, cpp_catch) 
				cast(*mut AstBuilderToken, stack.operand_tokens)[(stack.operand_count - cast(u32, 1))] = catch_token 
				cpp_operator_set(lexeme, peek(core)) 
				continue
			} else if (lexeme.token == OpMemberOrRef) then {
				let source_id = lexeme.source_id 
				pop_to_precedence(core, (stack).&, cast(u8, 1), True) 
				skip(core) 
				cpp_operator_set(lexeme, peek(core)) 
				if (lexeme.token != Ident) then
					parse_error_fatal(core, lexeme.source_id, ParseMemberUnexpectedToken) 
				let member_token = push_node(core, cast(*mut AstBuilderToken, stack.operand_tokens)[(stack.operand_count - cast(u32, 1))], source_id, EMPTY, .{
lexeme.identifier_id, 
							cast(u32, 0)
						}) 
				cast(*mut AstBuilderToken, stack.operand_tokens)[(stack.operand_count - cast(u32, 1))] = member_token
			} else if (lexeme.token == KwdImpl) then {
				let source_id = lexeme.source_id 
				mut flags = EMPTY 
				pop_to_precedence(core, (stack).&, cast(u8, 9), True) 
				skip(core) 
				parse_expr(core, False) 
				cpp_operator_set(lexeme, next(core)) 
				if (lexeme.token != CurlyL) then
					parse_error_fatal(core, lexeme.source_id, ParseImplExpectOpeningCurly) 
				for True do {
					cpp_operator_set(lexeme, peek(core)) 
					if (lexeme.token == CurlyR) then
						break {} 
					parse_definition(core, True, False, False, cast(*mut Maybe(SourceId), null))
				} 
				let impl_token = push_node(core, cast(*mut AstBuilderToken, stack.operand_tokens)[(stack.operand_count - cast(u32, 1))], source_id, flags, .{
							none(), 
							cast(u32, 0)
						}) 
				cast(*mut AstBuilderToken, stack.operand_tokens)[(stack.operand_count - cast(u32, 1))] = impl_token
			} else {
				let token_ordinal = cast(u8, lexeme.token) 
				let lo_ordinal = cast(u8, OpMulOrTypPtr) 
				let hi_ordinal = cast(u8, OpSetShr) 
				if (((cast(int, token_ordinal) < cast(int, lo_ordinal)) || (cast(int, token_ordinal) > cast(int, hi_ordinal))) || ((!(allow_complex) && (lexeme.token == OpSet)))) then
					break {} 
				let op = /* cpp ctor */ init(cast(*OperatorDesc, BINARY_OPERATOR_DESCS)[(cast(int, token_ordinal) - cast(int, lo_ordinal))]) 
				push_operator(core, (stack).&, .{
						/* cpp ctor */ init(op), 
lexeme.source_id
					}) 
				expecting_operand = cast(bool, op.is_binary)
			}
		} 
		skip(core) 
		cpp_operator_set(lexeme, peek(core))
	} 
	return pop_remaining(core, (stack).&)
}

pub parse_file = proc(mut core: *mut CoreData) -> bool => {
	if (cpp_leading_underscore_setjmp(cast(*mut cpp_leading_underscore_JBTYPE, core.parser.&.error_jump_buffer)) != 0) then
		return False 
	mut first_child_token = NO_CHILDREN 
	mut member_count = cast(u32, 0) 
	for True do {
		let lexeme = peek(core) 
		if is_definition_start(lexeme.token) then {
			let curr_token = parse_definition(core, True, False, False, cast(*mut Maybe(SourceId), null)) 
			if (first_child_token == NO_CHILDREN) then
				first_child_token = curr_token 
			member_count = cast(u32, 1)
		} else if (lexeme.token == END_OF_SOURCE) then {
			break {}
		} else {
			parse_error_continuable(core, lexeme.source_id, ParseUnexpectedTopLevelExpr) 
			core.parser.&.suppress_errors = True 
			let curr_token = parse_expr(core, True) 
			core.parser.&.suppress_errors = False 
			if (first_child_token == NO_CHILDREN) then
				first_child_token = curr_token
		}
	} 
	{} 
	push_node(core, first_child_token, .{
			cast(SourceId, core.parser.&.source_id_base)
		}, EMPTY, .{
			member_count, 
			cast(u32, 0)
		}) 
	return !(core.parser.&.has_errors)
}

pub parser_validate_config = proc(mut config: *Config, mut sink: PrintSink) -> bool => {
	return True
}

pub parser_memory_requirements = proc(mut config: *Config) -> MemoryRequirements => {
	mut reqs = /* cpp ctor */ init() 
	reqs.count = cast(u32, 0) 
	return /* cpp ctor */ init(reqs)
}

pub parser_init = proc(mut core: *mut CoreData, mut allocation: MemoryAllocation) -> void => {
	let parser = (core.parser.&).& 
	parser.u8_type_id.& = type_create_numeric(core, Integer, .{
				cast(u16, 8), 
				False, 
				.{ }
			}) 
	parser.suppress_errors.& = False for keyword <- KEYWORDS do
		identifier_set_attachment(core, range(), attachment())
}

pub parse = proc(mut core: *mut CoreData, mut content: Range(char8), mut source_id_base: SourceId, mut is_std: bool) -> Maybe(*mut AstNode) => {
	for true do {
		{
			{
				if !((((count() != cast(u64, 0)) && (cast(int, end()[-(1)]) == cast(int, '\x00'))))) then
					assert_or_ignore_helper(cast(*char, "core/parse.cpp"), cast(u32, 2930), cast(*char, "content.count() != 0 && content.end()[-1] == '\\0'"))
			}
		}
		if !(False) then 
			break {}
	} 
	core.parser.&.begin = begin() 
	core.parser.&.end = (end() - 1) 
	core.parser.&.curr = begin() 
	core.parser.&.source_id_base = cast(u32, source_id_base) 
	core.parser.&.peek.token = EMPTY 
	core.parser.&.is_std = is_std 
	core.parser.&.has_errors = False 
	if !(parse_file(core)) then
		return none() 
	let root = complete_ast(core) 
	return some(root)
}

