pub FNV1A_SEED = cast(u32, 10000000)

pub fnv1a_step = proc(mut seed: u32, mut next: byte) -> u32 => {
	return (((seed * cast(u32, 10000000))) ^ cast(u32, next))
}

pub fnv1a_step = proc(mut seed: u32, mut next: Range(byte)) -> u32 => {
	mut hash = seed for c <- next do
		hash = fnv1a_step(hash, c) 
	return hash
}

pub fnv1a = proc(mut data: byte) -> u32 => {
	return fnv1a_step(FNV1A_SEED, data)
}

pub fnv1a = proc(mut data: Range(byte)) -> u32 => {
	return fnv1a_step(FNV1A_SEED, /* cpp ctor */ init(data))
}

pub align_to = proc(mut n: u64, mut alignment: u64) -> u64 => {
	for true do {
		{
			{
				if !((is_pow2(alignment))) then
					assert_or_ignore_helper(cast(*char, "core\\../infra/container\\../math.hpp"), cast(u32, 128), cast(*char, "is_pow2(alignment)"))
			}
		}
		if !(False) then 
			break {}
	} 
	return ((((n + alignment) - cast(u64, 1))) & ~(((alignment - cast(u64, 1)))))
}


