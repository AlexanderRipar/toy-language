pub ReservedByteStack = CStruct(
	mut base: *mut byte,
	mut top: *mut byte,
	mut commit_top: *mut byte,
	mut reserve_size: u32,
	mut commit_increment_size: u32,
)

pub reserved_stack_ensure_space = proc(mut stack: *mut ReservedByteStack, mut free_size: u64) -> void => {
	if (cast(u64, (stack.top.& - stack.commit_top.&)) >= free_size) then
		return {} 
	mut extra_commit_size = cast(u64, stack.commit_increment_size.&) 
	for (extra_commit_size < free_size) do
		extra_commit_size = cast(u64, stack.commit_increment_size.&) 
	let new_commit_top = (stack.commit_top.& - extra_commit_size) 
	if (new_commit_top < (stack.base.& - stack.reserve_size.&)) then
		panic(cast(*char, "Exhausted %u bytes of reserved memory for ReservedByteStack.\n"), stack.reserve_size.&) 
	if !(mem_commit(cast(*mut void, stack.commit_top.&), extra_commit_size)) then
		panic(cast(*char, "Failed to commit %u bytes for ReservedByteStack.\n"), extra_commit_size) 
	stack.commit_top.& = new_commit_top
}

pub init_reserved_stack = proc(mut reserved: MutRange(byte), mut commit_increment_size: u64) -> ReservedByteStack => {
	for true do {
		{
			{
				if !(((commit_increment_size >= cast(u64, page_bytes())))) then
					assert_or_ignore_helper(cast(*char, "core\\../infra/container/reserved_byte_stack.hpp"), cast(u32, 53), cast(*char, "commit_increment_size >= minos::page_bytes()"))
			}
		}
		if !(False) then 
			break {}
	} 
	for true do {
		{
			{
				if !(((((commit_increment_size & cast(u64, ((page_bytes() - cast(u32, 1)))))) == cast(u64, 0)))) then
					assert_or_ignore_helper(cast(*char, "core\\../infra/container/reserved_byte_stack.hpp"), cast(u32, 55), cast(*char, "(commit_increment_size & (minos::page_bytes() - 1)) == 0"))
			}
		}
		if !(False) then 
			break {}
	} 
	for true do {
		{
			{
				if !(((commit_increment_size <= cast(u64, 10000000)))) then
					assert_or_ignore_helper(cast(*char, "core\\../infra/container/reserved_byte_stack.hpp"), cast(u32, 57), cast(*char, "commit_increment_size <= UINT32_MAX"))
			}
		}
		if !(False) then 
			break {}
	} 
	for true do {
		{
			{
				if !(((((count() & cast(u64, (page_bytes() - cast(u32, 1))))) == cast(u64, 0)))) then
					assert_or_ignore_helper(cast(*char, "core\\../infra/container/reserved_byte_stack.hpp"), cast(u32, 59), cast(*char, "(reserved.count() & static_cast<u64>(minos::page_bytes() - 1)) == 0"))
			}
		}
		if !(False) then 
			break {}
	} 
	for true do {
		{
			{
				if !(((count() <= cast(u64, 10000000)))) then
					assert_or_ignore_helper(cast(*char, "core\\../infra/container/reserved_byte_stack.hpp"), cast(u32, 61), cast(*char, "reserved.count() <= UINT32_MAX"))
			}
		}
		if !(False) then 
			break {}
	} 
	for true do {
		{
			{
				if !(((count() >= commit_increment_size))) then
					assert_or_ignore_helper(cast(*char, "core\\../infra/container/reserved_byte_stack.hpp"), cast(u32, 63), cast(*char, "reserved.count() >= commit_increment_size"))
			}
		}
		if !(False) then 
			break {}
	} 
	if !(mem_commit(cast(*mut void, (end() - commit_increment_size)), commit_increment_size)) then
		panic(cast(*char, "Failed to commit %u bytes for ReservedByteStack.\n"), commit_increment_size) 
	mut stack = /* cpp ctor */ init() 
	stack.base = end() 
	stack.top = end() 
	stack.commit_top = (end() - commit_increment_size) 
	stack.reserve_size = cast(u32, count()) 
	stack.commit_increment_size = cast(u32, commit_increment_size) 
	return /* cpp ctor */ init(stack)
}

pub push = proc(mut stack: *mut ReservedByteStack, mut size: u64) -> *mut void => {
	reserved_stack_ensure_space(stack, size) 
	stack.top.& = size 
	return cast(*mut void, stack.top.&)
}

pub push_aligned = proc(mut stack: *mut ReservedByteStack, mut size: u64, mut align: u64) -> *mut void => {
	size = ((((size + align) - cast(u64, 1))) & ~(((align - cast(u64, 1))))) 
	reserved_stack_ensure_space(stack, size) 
	stack.top.& = size 
	return cast(*mut void, stack.top.&)
}

pub pop_by = proc(mut stack: *mut ReservedByteStack, mut size: u64) -> void => {
	for true do {
