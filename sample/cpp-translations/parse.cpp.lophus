}

pub pad_to_alignment = proc(mut stack: *mut ReservedByteStack, mut padded_align: u64) -> void => {
	for true do {
		{
			{
				if !((((padded_align != cast(u64, 0)) && is_pow2(padded_align)))) then
					assert_or_ignore_helper(cast(*char, "core\\../infra/container/reserved_byte_stack.hpp"), cast(u32, 114), cast(*char, "padded_align != 0 && is_pow2(padded_align)"))
			}
		}
		if !(False) then 
			break {}
	} 
	let top = bitcast(u64, stack.top.&) 
	let new_top = (top & ((padded_align - cast(u64, 1)))) 
	reserved_stack_ensure_space(stack, (top - new_top)) 
	stack.top.& = bitcast(*mut byte, new_top)
}

