pub INVALID_HEX_CHAR_VALUE = cast(u8, 255)

pub is_whitespace = proc(mut c: char8) -> bool => {
	return ((((cast(int, c) == cast(int, ' ')) || (cast(int, c) == cast(int, '\t'))) || (cast(int, c) == cast(int, '\n'))) || (cast(int, c) == cast(int, '\r')))
}

pub is_alphabetic_char = proc(mut c: char8) -> bool => {
	return ((((cast(int, c) >= cast(int, 'a')) && (cast(int, c) <= cast(int, 'z')))) || (((cast(int, c) >= cast(int, 'A')) && (cast(int, c) <= cast(int, 'Z')))))
}

pub is_numeric_char = proc(mut c: char8) -> bool => {
	return ((cast(int, c) >= cast(int, '0')) && (cast(int, c) <= cast(int, '9')))
}

pub is_identifier_continuation_char = proc(mut c: char8) -> bool => {
	return ((is_alphabetic_char(c) || is_numeric_char(c)) || (cast(int, c) == cast(int, '_')))
}

pub hex_char_value = proc(mut c: char8) -> u8 => {
	if ((cast(int, c) >= cast(int, 'a')) && (cast(int, c) <= cast(int, 'f'))) then
		return cast(u8, ((10 + cast(int, c)) - cast(int, 'a')))
	else if ((cast(int, c) >= cast(int, 'A')) && (cast(int, c) <= cast(int, 'F'))) then
		return cast(u8, ((10 + cast(int, c)) - cast(int, 'A')))
	else if ((cast(int, c) >= cast(int, '0')) && (cast(int, c) <= cast(int, '9'))) then
		return cast(u8, (cast(int, c) - cast(int, '0')))
	else
		return INVALID_HEX_CHAR_VALUE
}

pub parse_error_fatal = proc(mut core: *mut CoreData, mut source_id: SourceId, mut error: CompileError) -> void => {
	if !(core.parser.&.suppress_errors) then
		cast(void, record_error(core, source_id, error)) 
	longjmp(cast(*mut cpp_leading_underscore_JBTYPE, core.parser.&.error_jump_buffer), 1)
}

pub parse_error_continuable = proc(mut core: *mut CoreData, mut source_id: SourceId, mut error: CompileError) -> void => {
	if !(core.parser.&.suppress_errors) then
		cast(void, record_error(core, source_id, error)) 
	core.parser.&.has_errors = True
}

pub skip_block_comment = proc(mut core: *mut CoreData) -> void => {
	mut curr = core.parser.&.curr 
	curr = 2 
	mut comment_nesting = cast(u32, 1) 
	for (comment_nesting != cast(u32, 0)) do {
		let c = (curr).* 
		if (cast(int, c) == cast(int, '/')) then {
			if (cast(int, curr[1]) == cast(int, '*')) then {
				curr = 2 
				comment_nesting = cast(u32, 1)
			} else {
				curr = 1
			}
		} else if (cast(int, c) == cast(int, '*')) then {
			if (cast(int, curr[1]) == cast(int, '/')) then {
				curr = 2 
				comment_nesting = cast(u32, 1)
			} else {
				curr = 1
			}
		} else if (cast(int, c) == cast(int, '\x00')) then {
			let error = if (core.parser.&.curr == core.parser.&.end) then
					LexCommentMismatchedBegin
else
					LexNullCharacter 
			parse_error_fatal(core, cast(SourceId, (core.parser.&.source_id_base + cast(u32, (curr - core.parser.&.curr)))), error)
		} else {
			curr = 1
		}
	} 
	core.parser.&.curr = curr
}

pub skip_whitespace = proc(mut core: *mut CoreData) -> void => {
	mut curr = core.parser.&.curr 
	for True do {
		for is_whitespace((curr).*) do
			curr = 1 
		if (cast(int, (curr).*) == cast(int, '/')) then {
			if (cast(int, curr[1]) == cast(int, '/')) then {
				curr = 2 
				for ((cast(int, (curr).*) != cast(int, '\n')) && (cast(int, (curr).*) != cast(int, '\x00'))) do
					curr = 1
			} else if (cast(int, curr[1]) == cast(int, '*')) then {
				core.parser.&.curr = curr 
				skip_block_comment(core) 
				curr = core.parser.&.curr
			} else {
				break {}
			}
		} else {
			break {}
		}
	} 
	core.parser.&.curr = curr
}

pub scan_identifier_token = proc(mut core: *mut CoreData, mut is_builtin: bool) -> Lexeme => {
	mut curr = core.parser.&.curr 
	let token_begin = (curr - 1) 
	for is_identifier_continuation_char((curr).*) do
		curr = 1 
	core.parser.&.curr = curr 
	let identifier_bytes = /* cpp ctor */ init(token_begin, curr) 
	 identifier_attachment = undefined 
	let identifier_id = id_and_attachment_from_identifier(core, /* cpp ctor */ init(identifier_bytes), (identifier_attachment).&) 
	if is_builtin then {
		let builtin = cast(Builtin, identifier_attachment) 
		if (builtin == INVALID) then
			parse_error_fatal(core, core.parser.&.peek.source_id, LexBuiltinUnknown) 
		mut rst = /* cpp ctor */ init() 
		rst.token = Builtin 
		rst.builtin = builtin 
		return /* cpp ctor */ init(rst)
	} else {
		let token = if (cast(int, identifier_attachment) == 0) then
				Ident
else
				cast(Token, identifier_attachment) 
		mut rst = /* cpp ctor */ init() 
		rst.token = token 
		rst.identifier_id = if (token == Ident) then
				identifier_id
else
				INVALID 
		return /* cpp ctor */ init(rst)
	}
}

pub scan_number_token_with_base = proc(mut core: *mut CoreData, mut base: char8) -> Lexeme => {
	mut curr = core.parser.&.curr 
	let token_begin = curr 
	curr = 1 
	mut integer_value = comp_integer_from_u64(cast(u64, 0)) 
	if (cast(int, base) == cast(int, 'b')) then {
		for ((cast(int, (curr).*) == cast(int, '0')) || (cast(int, (curr).*) == cast(int, '1'))) do {
			cpp_operator_set(integer_value, comp_integer_add(comp_integer_mul(/* cpp ctor */ init(integer_value), comp_integer_from_u64(cast(u64, 10))), comp_integer_from_u64(cast(u64, (cast(int, (curr).*) - cast(int, '0')))))) 
			curr = 1
		}
	} else if (cast(int, base) == cast(int, 'o')) then {
		for ((cast(int, (curr).*) >= cast(int, '0')) && (cast(int, (curr).*) <= cast(int, '7'))) do {
			cpp_operator_set(integer_value, comp_integer_add(comp_integer_mul(/* cpp ctor */ init(integer_value), comp_integer_from_u64(cast(u64, 8))), comp_integer_from_u64(cast(u64, (cast(int, (curr).*) - cast(int, '0')))))) 
			curr = 1
		}
	} else {
		for true do {
			{
				{
					if !(((cast(int, base) == cast(int, 'x')))) then
						assert_or_ignore_helper(cast(*char, "core/parse.cpp"), cast(u32, 610), cast(*char, "base == 'x'"))
				}
			}
			if !(False) then 
				break {}
		} 
		for True do {
			let hex = hex_char_value((curr).*) 
			if (cast(int, hex) == cast(int, INVALID_HEX_CHAR_VALUE)) then
				break {} 
			cpp_operator_set(integer_value, comp_integer_add(comp_integer_mul(/* cpp ctor */ init(integer_value), comp_integer_from_u64(cast(u64, 16))), comp_integer_from_u64(cast(u64, hex)))) 
			curr = 1
		}
	} 
	if (curr == (token_begin + 1)) then
		parse_error_fatal(core, core.parser.&.peek.source_id, LexNumberWithBaseMissingDigits) 
	if is_identifier_continuation_char((curr).*) then
		parse_error_fatal(core, core.parser.&.peek.source_id, LexNumberUnexpectedCharacterAfterInteger) 
	core.parser.&.curr = curr 
	mut rst = /* cpp ctor */ init() 
	rst.token = LitInteger 
	cpp_operator_set(rst.integer_value, integer_value) 
	return /* cpp ctor */ init(rst)
}

pub scan_utf8_char_surrogates = proc(mut core: *mut CoreData, mut leader_value: u32, mut surrogate_count: u32) -> u32 => {
	mut curr = core.parser.&.curr 
	mut codepoint = leader_value 
	for (i != surrogate_count), preinc(i.&) do {
		let surrogate = curr[(i + cast(u32, 1))] 
		if (((cast(int, surrogate) & 192)) != 128) then
			parse_error_fatal(core, core.parser.&.peek.source_id, LexCharacterBadSurrogateCodeUnit) 
		codepoint = cast(u32, (((cast(int, surrogate) & 63)) << ((cast(u32, 6) * (((surrogate_count - i) - cast(u32, 1)))))))
	} 
	core.parser.&.curr = (surrogate_count + cast(u32, 1)) 
	return codepoint
}

pub scan_utf8_char = proc(mut core: *mut CoreData) -> u32 => {
	let first = (core.parser.&.curr).* 
	if (((cast(int, first) & 128)) == 0) then {
		core.parser.&.curr = 1 
		return cast(u32, first)
	} else if (((cast(int, first) & 224)) == 192) then {
		return scan_utf8_char_surrogates(core, cast(u32, (((cast(int, first) & 31)) << 6)), cast(u32, 1))
	} else if (((cast(int, first) & 240)) == 224) then {
		return scan_utf8_char_surrogates(core, cast(u32, (((cast(int, first) & 15)) << 12)), cast(u32, 2))
	} else if (((cast(int, first) & 248)) == 240) then {
		return scan_utf8_char_surrogates(core, cast(u32, (((cast(int, first) & 7)) << 18)), cast(u32, 3))
	} else {
		parse_error_fatal(core, core.parser.&.peek.source_id, LexCharacterBadLeadCodeUnit)
	}
}

pub scan_escape_char = proc(mut core: *mut CoreData) -> u32 => {
	mut curr = core.parser.&.curr 
	mut codepoint = cast(u32, 0) 
	let escapee = curr[1] 
	switch cast(int, escapee)
		case cast(int, 'x') -> { 
			{
				let hi = hex_char_value(curr[2]) 
				if (cast(int, hi) == cast(int, INVALID_HEX_CHAR_VALUE)) then
					parse_error_fatal(core, core.parser.&.peek.source_id, LexCharacterEscapeSequenceLowerXBadChar) 
				let lo = hex_char_value(curr[3]) 
				if (cast(int, lo) == cast(int, INVALID_HEX_CHAR_VALUE)) then
					parse_error_fatal(core, core.parser.&.peek.source_id, LexCharacterEscapeSequenceLowerXBadChar) 
				curr = 2 
				codepoint = cast(u32, (cast(int, lo) + (cast(int, hi) * 16))) 
				break {}
			}
		}
		case cast(int, 'X') -> { 
			{
				codepoint = cast(u32, 0) 
				for (i != cast(u32, 6)), preinc(i.&) do {
					let char_value = hex_char_value(curr[(i + cast(u32, 2))]) 
					if (cast(int, char_value) == cast(int, INVALID_HEX_CHAR_VALUE)) then
						parse_error_fatal(core, core.parser.&.peek.source_id, LexCharacterEscapeSequenceUpperXInvalidChar) 
					codepoint = ((codepoint * cast(u32, 16)) + cast(u32, char_value))
				} 
				if (codepoint > cast(u32, 1114111)) then
					parse_error_fatal(core, core.parser.&.peek.source_id, LexCharacterEscapeSequenceUpperXCodepointTooLarge) 
				curr = 6 
				break {}
			}
		}
		case cast(int, 'u') -> { 
			{
				for (i != cast(u32, 4)), preinc(i.&) do {
					let c = curr[(i + cast(u32, 2))] 
					if ((cast(int, c) < cast(int, '0')) || (cast(int, c) > cast(int, '9'))) then
						parse_error_fatal(core, core.parser.&.peek.source_id, LexCharacterEscapeSequenceUInvalidChar) 
					codepoint = (((codepoint * cast(u32, 10)) + cast(u32, c)) - cast(u32, '0'))
				} 
				curr = 4 
				break {}
			}
		}
		case cast(int, '\\') -> { 
		}
		case cast(int, '0') -> { 
			codepoint = cast(u32, '\x00')
		}
		case cast(int, 'a') -> { 
			codepoint = cast(u32, '\x07')
		}
		case cast(int, 'b') -> { 
			codepoint = cast(u32, '\x08')
		}
		case cast(int, 'f') -> { 
			codepoint = cast(u32, '\x0C')
		}
		case cast(int, 'n') -> { 
			codepoint = cast(u32, '\n')
		}
		case cast(int, 'r') -> { 
			codepoint = cast(u32, '\r')
		}
		case cast(int, 't') -> { 
			codepoint = cast(u32, '\t')
		}
		case cast(int, 'v') -> { 
			codepoint = cast(u32, '\x0B')
		} 
	core.parser.&.curr = (curr + 2) 
	return codepoint
}

pub scan_number_token = proc(mut core: *mut CoreData, mut first: char8) -> Lexeme => {
	mut curr = core.parser.&.curr 
	let token_begin = (curr - 1) 
	mut integer_value = comp_integer_from_u64(cast(u64, (cast(int, first) - cast(int, '0')))) 
	for is_numeric_char((curr).*) do {
		cpp_operator_set(integer_value, comp_integer_add(comp_integer_mul(/* cpp ctor */ init(integer_value), comp_integer_from_u64(cast(u64, 10))), comp_integer_from_u64(cast(u64, (cast(int, (curr).*) - cast(int, '0')))))) 
		curr = 1
	} 
	if ((cast(int, (curr).*) == cast(int, '.')) && (cast(int, curr[1]) != cast(int, '.'))) then {
		curr = 1 
		if !(is_numeric_char((curr).*)) then
			parse_error_fatal(core, core.parser.&.peek.source_id, LexNumberUnexpectedCharacterAfterDecimalPoint) 
		for is_numeric_char((curr).*) do
			curr = 1 
		if (cast(int, (curr).*) == cast(int, 'e')) then {
			curr = 1 
			if ((cast(int, (curr).*) == cast(int, '+')) || (cast(int, (curr).*) == cast(int, '-'))) then
				curr = 1 
			for is_numeric_char((curr).*) do
				curr = 1
		} 
		if (is_alphabetic_char((curr).*) || (cast(int, (curr).*) == cast(int, '_'))) then
			parse_error_fatal(core, core.parser.&.peek.source_id, LexNumberUnexpectedCharacterAfterFloat) 
		 strtod_end = undefined 
		((cpp_leading_underscore_errno()).*) = 0 
		let float_value = strtod(token_begin, (strtod_end).&) 
		for true do {
			{
				{
					if !(((strtod_end == curr))) then
						assert_or_ignore_helper(cast(*char, "core/parse.cpp"), cast(u32, 850), cast(*char, "strtod_end == curr"))
				}
			}
			if !(False) then 
				break {}
		} 
		if (((cpp_leading_underscore_errno()).*) == 34) then
			parse_error_fatal(core, core.parser.&.peek.source_id, LexNumberFloatTooLarge) 
		core.parser.&.curr = curr 
		mut rst = /* cpp ctor */ init() 
		rst.token = LitFloat 
		cpp_operator_set(rst.float_value, comp_float_from_f64(float_value)) 
		return /* cpp ctor */ init(rst)
	} else {
		if (is_alphabetic_char((curr).*) || (cast(int, (curr).*) == cast(int, '_'))) then
			parse_error_fatal(core, core.parser.&.peek.source_id, LexNumberUnexpectedCharacterAfterFloat) 
		core.parser.&.curr = curr 
		mut rst = /* cpp ctor */ init() 
		rst.token = LitInteger 
		cpp_operator_set(rst.integer_value, integer_value) 
		return /* cpp ctor */ init(rst)
	}
}

pub scan_char_token = proc(mut core: *mut CoreData) -> Lexeme => {
	 codepoint = undefined 
	if (cast(int, (core.parser.&.curr).*) == cast(int, '\\')) then
		codepoint = scan_escape_char(core)
	else
		codepoint = scan_utf8_char(core) 
	if (cast(int, (core.parser.&.curr).*) != cast(int, '\'')) then
		parse_error_fatal(core, core.parser.&.peek.source_id, LexCharacterExpectedEnd) 
	core.parser.&.curr = 1 
	mut rst = /* cpp ctor */ init() 
	rst.token = LitChar 
	rst.char_value = codepoint 
	return /* cpp ctor */ init(rst)
}

pub scan_string_token = proc(mut core: *mut CoreData) -> Lexeme => {
	 buffer = undefined 
	mut buffer_index = cast(u32, 0) 
	mut curr = core.parser.&.curr 
	mut copy_begin = curr 
	for (cast(int, (curr).*) != cast(int, '"')) do {
		if (cast(int, (curr).*) == cast(int, '\\')) then {
			let bytes_to_copy = cast(u32, (curr - copy_begin)) 
			if (cast(unsignedlonglong, (buffer_index + bytes_to_copy)) > sizeof((buffer))) then
				parse_error_fatal(core, core.parser.&.peek.source_id, LexStringTooLong) 
			memcpy(cast(*mut void, (cast(*mut char8, buffer) + buffer_index)), cast(*void, copy_begin), cast(size_t, bytes_to_copy)) 
			buffer_index = bytes_to_copy 
			core.parser.&.curr = curr 
			let codepoint = scan_escape_char(core) 
			curr = core.parser.&.curr 
			if (codepoint <= cast(u32, 127)) then {
				if (cast(unsignedlonglong, (buffer_index + cast(u32, 1))) > sizeof((buffer))) then
					parse_error_fatal(core, core.parser.&.peek.source_id, LexStringTooLong) 
				cast(*mut char8, buffer)[buffer_index] = cast(char8, codepoint) 
				buffer_index = cast(u32, 1)
			} else if (codepoint <= cast(u32, 2047)) then {
				if (cast(unsignedlonglong, (buffer_index + cast(u32, 2))) > sizeof((buffer))) then
					parse_error_fatal(core, core.parser.&.peek.source_id, LexStringTooLong) 
				cast(*mut char8, buffer)[buffer_index] = cast(char8, (((codepoint >> 6)) | cast(u32, 192))) 
				cast(*mut char8, buffer)[(buffer_index + cast(u32, 1))] = cast(char8, (((codepoint & cast(u32, 63))) | cast(u32, 128))) 
				buffer_index = cast(u32, 2)
			} else if (codepoint == cast(u32, 65536)) then {
				if (cast(unsignedlonglong, (buffer_index + cast(u32, 3))) > sizeof((buffer))) then
					parse_error_fatal(core, core.parser.&.peek.source_id, LexStringTooLong) 
				cast(*mut char8, buffer)[buffer_index] = cast(char8, (((codepoint >> 12)) | cast(u32, 224))) 
				cast(*mut char8, buffer)[(buffer_index + cast(u32, 1))] = cast(char8, (((((codepoint >> 6)) & cast(u32, 63))) | cast(u32, 128))) 
				cast(*mut char8, buffer)[(buffer_index + cast(u32, 2))] = cast(char8, (((codepoint & cast(u32, 63))) | cast(u32, 128))) 
				buffer_index = cast(u32, 3)
			} else {
				for true do {
					{
						{
							if !(((codepoint <= cast(u32, 1114111)))) then
								assert_or_ignore_helper(cast(*char, "core/parse.cpp"), cast(u32, 963), cast(*char, "codepoint <= 0x10FFFF"))
						}
					}
					if !(False) then 
						break {}
				} 
				if (cast(unsignedlonglong, (buffer_index + cast(u32, 4))) > sizeof((buffer))) then
					parse_error_fatal(core, core.parser.&.peek.source_id, LexStringTooLong) 
				cast(*mut char8, buffer)[buffer_index] = cast(char8, (((codepoint >> 18)) | cast(u32, 224))) 
				cast(*mut char8, buffer)[(buffer_index + cast(u32, 1))] = cast(char8, (((((codepoint >> 12)) & cast(u32, 63))) | cast(u32, 128))) 
				cast(*mut char8, buffer)[(buffer_index + cast(u32, 2))] = cast(char8, (((((codepoint >> 6)) & cast(u32, 63))) | cast(u32, 128))) 
				cast(*mut char8, buffer)[(buffer_index + cast(u32, 3))] = cast(char8, (((codepoint & cast(u32, 63))) | cast(u32, 128))) 
				buffer_index = cast(u32, 4)
			} 
			copy_begin = (cast(*mut char8, buffer) + buffer_index)
		} else if (cast(int, (curr).*) == cast(int, '\n')) then {
			parse_error_fatal(core, core.parser.&.peek.source_id, LexStringCrossesNewline)
		} else if (cast(int, (curr).*) == cast(int, '\x00')) then {
			parse_error_fatal(core, core.parser.&.peek.source_id, LexStringMissingEnd)
		} else {
			curr = 1
		}
	} 
	let bytes_to_copy = cast(u32, (curr - copy_begin)) 
	if (cast(unsignedlonglong, (buffer_index + bytes_to_copy)) > sizeof((buffer))) then
		parse_error_fatal(core, core.parser.&.peek.source_id, LexStringTooLong) 
	memcpy(cast(*mut void, (cast(*mut char8, buffer) + buffer_index)), cast(*void, copy_begin), cast(size_t, bytes_to_copy)) 
	buffer_index = bytes_to_copy 
	let allocation = comp_heap_alloc(core, cast(u64, buffer_index), cast(u64, 1)) 
	if is_none(/* cpp ctor */ init(allocation)) then
		todo_helper(cast(*char, "scan_string_token"), cast(*char, "core/parse.cpp"), cast(u32, 1007), cast(*char, "Implement GC traversal.")) 
	memcpy(get(/* cpp ctor */ init(allocation)), cast(*void, cast(*mut char8, buffer)), cast(size_t, buffer_index)) 
	core.parser.&.curr = (curr + 1) 
	mut rst = /* cpp ctor */ init() 
	rst.token = LitString 
	rst.string.value_begin = core_id_from_address(core, get(/* cpp ctor */ init(allocation))) 
	rst.string.value_size = buffer_index 
	return /* cpp ctor */ init(rst)
}

pub next_without_source = proc(mut core: *mut CoreData) -> Lexeme => {
	let first = (core.parser.&.curr).* 
