pub cpp_operator_bitor = proc(mut lhs: AstFlag, mut rhs: AstFlag) -> AstFlag => {
	return cast(AstFlag, (cast(int, cast(u8, lhs)) | cast(int, cast(u8, rhs))))
}

pub cpp_operator_bitand = proc(mut lhs: AstFlag, mut rhs: AstFlag) -> AstFlag => {
	return cast(AstFlag, (cast(int, cast(u8, lhs)) & cast(int, cast(u8, rhs))))
}

pub cpp_operator_bitor_set = proc(mut lhs: *mut AstFlag, mut rhs: AstFlag) -> *mut AstFlag => {
	lhs = cpp_operator_bitor(lhs, rhs) 
	return lhs
}

pub cpp_operator_bitand_set = proc(mut lhs: *mut AstFlag, mut rhs: AstFlag) -> *mut AstFlag => {
	lhs = cpp_operator_bitand(lhs, rhs) 
	return lhs
}


