pub token_name = proc(mut token: Token) -> *char8 => {
	let TOKEN_NAMES = .{
			cast(*char, "[Unknown]"), 
			cast(*char, "if"), 
			cast(*char, "then"), 
			cast(*char, "else"), 
			cast(*char, "for"), 
			cast(*char, "do"), 
			cast(*char, "finally"), 
			cast(*char, "switch"), 
			cast(*char, "case"), 
			cast(*char, "func"), 
			cast(*char, "proc"), 
			cast(*char, "trait"), 
			cast(*char, "impl"), 
			cast(*char, "self"), 
			cast(*char, "where"), 
			cast(*char, "requires"), 
			cast(*char, "ensures"), 
			cast(*char, "catch"), 
			cast(*char, "let"), 
			cast(*char, "pub"), 
			cast(*char, "mut"), 
			cast(*char, "unreachable"), 
			cast(*char, "undefined"), 
			cast(*char, "return"), 
			cast(*char, "break"), 
			cast(*char, "."), 
			cast(*char, ".."), 
			cast(*char, ".["), 
			cast(*char, ".{"), 
			cast(*char, "]"), 
			cast(*char, "["), 
			cast(*char, "}"), 
			cast(*char, "{"), 
			cast(*char, ")"), 
			cast(*char, "("), 
			cast(*char, "eval"), 
			cast(*char, "try"), 
			cast(*char, "defer"), 
			cast(*char, "distinct"), 
			cast(*char, "~"), 
			cast(*char, "!"), 
			cast(*char, "?"), 
			cast(*char, "..."), 
			cast(*char, "[...]"), 
			cast(*char, "[*]"), 
			cast(*char, "[?]"), 
			cast(*char, "[]"), 
			cast(*char, "*"), 
			cast(*char, "-"), 
			cast(*char, "+"), 
			cast(*char, "/"), 
			cast(*char, "+:"), 
			cast(*char, "-:"), 
			cast(*char, "*:"), 
			cast(*char, "%"), 
			cast(*char, ".&"), 
			cast(*char, ".*"), 
			cast(*char, "&"), 
			cast(*char, "|"), 
			cast(*char, "^"), 
			cast(*char, "<<"), 
			cast(*char, ">>"), 
			cast(*char, "&&"), 
			cast(*char, "||"), 
			cast(*char, "<"), 
			cast(*char, ">"), 
			cast(*char, "<="), 
			cast(*char, ">="), 
			cast(*char, "!="), 
			cast(*char, "=="), 
			cast(*char, "="), 
			cast(*char, "+="), 
			cast(*char, "-="), 
			cast(*char, "*="), 
			cast(*char, "/="), 
			cast(*char, "+:="), 
			cast(*char, "-:="), 
			cast(*char, "*:="), 
			cast(*char, "%="), 
			cast(*char, "&="), 
			cast(*char, "|="), 
			cast(*char, "^="), 
			cast(*char, "<<="), 
			cast(*char, ">>="), 
			cast(*char, ":"), 
			cast(*char, ","), 
			cast(*char, "<-"), 
			cast(*char, "->"), 
			cast(*char, "=>"), 
			cast(*char, "#"), 
			cast(*char, "LiteralInteger"), 
			cast(*char, "LiteralFloat"), 
			cast(*char, "LiteralChar"), 
			cast(*char, "LiteralString"), 
			cast(*char, "Identifier"), 
			cast(*char, "Builtin"), 
			cast(*char, "_"), 
			cast(*char, "[END-OF-SOURCE]")
		} 
	let ordinal = cast(u8, token) 
	if (cast(u64, ordinal) < array_count(TOKEN_NAMES)) then
		return cast(**char8, TOKEN_NAMES)[ordinal] 
	return cast(**char8, TOKEN_NAMES)[0]
}


