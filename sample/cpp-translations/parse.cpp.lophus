	} 
	stack.top.& = size
}

pub pop_to = proc(mut stack: *mut ReservedByteStack, mut new_top: u64) -> void => {
	for true do {
		{
			{
				if !((((stack.base.& + new_top) >= stack.top.&))) then
					assert_or_ignore_helper(cast(*char, "core\\../infra/container/reserved_byte_stack.hpp"), cast(u32, 107), cast(*char, "stack->base + new_top >= stack->top"))
			}
